# =============================================================================
#  .env.example — iMitra
# =============================================================================
#
#  Cara pakai:
#      cp .env.example .env
#  lalu sesuaikan nilainya. Berkas .env TIDAK BOLEH di-commit — sudah masuk
#  .gitignore. Brief §7.2 butir 7: tidak ada secret di dalam repo.
#  Secret ter-commit dikenai pengurangan -10, termasuk kalau sudah dihapus
#  di commit berikutnya (riwayat git tetap memuatnya).
#
#  Aturan berkas ini:
#    - Semua nilai di sini adalah PLACEHOLDER yang jelas-jelas bukan rahasia.
#      Kalau Anda menemukan nilai di berkas ini terlihat seperti secret sungguhan,
#      berarti seseorang salah meng-commit — segera laporkan ke Tech Lead.
#    - Setiap variabel baru yang dipakai kode WAJIB ditambahkan ke berkas ini
#      pada PR yang sama, beserta komentar singkat. Variabel yang hanya ada di
#      .env lokal seseorang adalah penyebab paling umum "jalan di laptop saya".
#    - Nama variabel di sini harus sama dengan yang dibaca kode dan yang dipakai
#      docker-compose.yml.
#
#  NILAI BAWAAN DI BERKAS INI SENGAJA BISA LANGSUNG DIPAKAI. Penilai menyalinnya
#  apa adanya lalu menjalankan `docker compose up`, dan seluruh sistem harus
#  hidup tanpa mereka mengubah satu baris pun.
# =============================================================================

# -----------------------------------------------------------------------------
# Umum
# -----------------------------------------------------------------------------
# development | test | production
APP_ENV=development

# Zona waktu. Berpengaruh pada bagian YYYYMMDD nomor referensi IMT-YYYYMMDD-NNNN
# (asumsi A-7 di docs/SRS-iMitra.md). Tetapkan eksplisit supaya nomor referensi
# tidak bergeser satu hari di mesin penilai. JANGAN diubah tanpa memperbarui SRS.
TZ=Asia/Jakarta

# Level log. Ingat BR-11: NIK dan path foto dokumen tidak boleh masuk log,
# pada level apa pun, termasuk debug. Redaksi ditegakkan di src/lib/logger.ts.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Port layanan (port di host)
# -----------------------------------------------------------------------------
# Sesuaikan kalau bentrok dengan layanan lain di laptop Anda. Kalau diubah,
# perbarui juga README.md bagian 2.3 supaya penilai membuka URL yang benar.
BACKEND_PORT=8080
FRONTEND_PORT=3000
MOCK_SLIK_PORT=9090
DB_PORT=5432

# -----------------------------------------------------------------------------
# MODE DATABASE — satu baris yang menentukan segalanya
# -----------------------------------------------------------------------------
#  lokal   -> container `db` di docker-compose.yml ikut hidup. INI BAWAAN, dan
#             inilah yang dipakai penilai dari clone bersih.
#  (kosong)-> container `db` dilewati; aplikasi memakai DATABASE_URL apa pun
#             yang Anda isi di bawah — untuk tim kami, Aiven.
#
#  Perintahnya tetap sama untuk keduanya: `docker compose up`.
#  Rincian lengkap: docs/DATABASE.md
COMPOSE_PROFILES=lokal

# -----------------------------------------------------------------------------
# Database — mode lokal (bawaan)
# -----------------------------------------------------------------------------
# DB_HOST=db bila dijalankan lewat docker compose (nama service),
# DB_HOST=localhost bila backend dijalankan langsung di host.
DB_HOST=db
DB_NAME=imitra
DB_USER=imitra_app
DB_PASSWORD=ganti-nilai-ini-bukan-password-sebenarnya

# Prisma membaca satu URL, bukan variabel terpisah. Nilai di bawah harus
# konsisten dengan empat variabel di atas.
DATABASE_URL=postgresql://imitra_app:ganti-nilai-ini-bukan-password-sebenarnya@db:5432/imitra?schema=public

# Schema terpisah untuk test otomatis, supaya test tidak menghapus data demo.
DATABASE_URL_TEST=postgresql://imitra_app:ganti-nilai-ini-bukan-password-sebenarnya@db:5432/imitra?schema=test

# -----------------------------------------------------------------------------
# Database — mode bersama tim (Aiven). ANGGOTA TIM: pakai bagian ini.
# -----------------------------------------------------------------------------
#  Cara memakainya di .env Anda sendiri (JANGAN di berkas ini):
#    1. Ubah COMPOSE_PROFILES di atas menjadi kosong: COMPOSE_PROFILES=
#    2. Ganti DATABASE_URL dan DATABASE_URL_TEST dengan bentuk di bawah
#    3. Ganti <password> dengan nilai dari Tech Lead, dan <nama> dengan nama Anda
#
#  DATABASE_URL=postgresql://avnadmin:<password>@imitra-tim2-imitratim2.l.aivencloud.com:13096/defaultdb?sslmode=require&schema=dev_<nama>&connection_limit=2
#  DATABASE_URL_TEST=postgresql://avnadmin:<password>@imitra-tim2-imitratim2.l.aivencloud.com:13096/defaultdb?sslmode=require&schema=test_<nama>&connection_limit=2
#
#  Host, port, database, dan username bukan rahasia — password-nya yang rahasia,
#  dan itu sebabnya ia TIDAK ADA di berkas ini. Mintakan ke Tech Lead lewat
#  kanal privat, bukan lewat issue atau commit.
#
#  Ejaan host: "imitra-tim2", SATU huruf t. Ejaan "imittra-" resolve di DNS
#  tetapi tidak menerima koneksi.
#
#  Tiga parameter yang WAJIB ada, dan alasannya:
#
#    sslmode=require   Aiven menolak koneksi tanpa TLS.
#
#    schema=dev_<nama> PostgreSQL schema, BUKAN database. Satu schema per orang
#                      (dev_firman, dev_alfian, dev_dani, dev_reffa, dev_ray,
#                      dev_eka) supaya `prisma migrate dev` milik satu orang
#                      tidak menghapus data lima orang lain. Schema `demo`
#                      dipakai bersama untuk data demo, dan HANYA Tech Lead yang
#                      menjalankan migrasi di sana.
#
#    connection_limit  Kuota Aiven kami 20 koneksi TOTAL untuk enam orang.
#                      Prisma membuka pool per proses; bawaannya
#                      num_cpus x 2 + 1 — di laptop 8 core itu 17 koneksi untuk
#                      SATU orang. Setel 2. Gejala kalau lupa: "too many
#                      connections" yang muncul acak di laptop ORANG LAIN.
#
#  Kalau password pernah tertulis di chat, issue, screenshot, atau layar yang
#  dibagikan — anggap sudah bocor dan minta Tech Lead memutarnya
#  (docs/DATABASE.md bagian 7).

# -----------------------------------------------------------------------------
# Autentikasi
# -----------------------------------------------------------------------------
# JWT secret. NILAI DI BAWAH BUKAN RAHASIA DAN TIDAK BOLEH DIPAKAI DI LUAR LATIHAN.
# Bangkitkan nilai acak untuk .env Anda sendiri, mis. dengan: openssl rand -hex 32
JWT_SECRET=contoh-nilai-placeholder-ganti-dengan-nilai-acak-anda-sendiri

# Masa berlaku token. Cukup panjang supaya demo tidak terputus di tengah,
# tetapi tetap terbatas.
JWT_EXPIRES_IN=8h

# Cost factor hashing password (bcrypt). Nilai tinggi memperlambat seed dan
# test; 10 memadai untuk latihan. Di produksi nilai ini naik — dan karena ia
# parameter env, kenaikannya tidak menyentuh kode.
PASSWORD_HASH_COST=10

# Password akun seed. Bukan rahasia — akun ini hanya ada di lingkungan demo.
# Didokumentasikan di README.md bagian 2.5 supaya penilai bisa login.
SEED_DEFAULT_PASSWORD=Demo1234!

# -----------------------------------------------------------------------------
# Mock SLIK
# -----------------------------------------------------------------------------
# URL dasar layanan mock SLIK. Backend WAJIB memanggilnya via HTTP,
# bukan sebagai fungsi lokal (brief §7.2 butir 3).
# Nama service docker (mock-slik) BENAR di sini, karena pemanggilnya container.
SLIK_BASE_URL=http://mock-slik:9090

# Path inquiry sesuai kontrak brief §6.1. Jangan diubah.
SLIK_INQUIRY_PATH=/slik/inquiry

# Timeout panggilan SLIK dalam milidetik. Jangan terlalu besar: penilai akan
# menguji jalur timeout, dan menunggu 30 detik di depan penilai bukan demo yang baik.
SLIK_TIMEOUT_MS=3000

# Jumlah percobaan ulang. 0 berarti tidak ada retry — itu keputusan sadar
# (SDD BAB 2.4): retry yang tidak dicatat menyembunyikan kegagalan, dan ANL
# berhak tahu bahwa panggilan SLIK gagal.
SLIK_RETRY=0

# CATATAN: masa berlaku hasil SLIK (BR-04, 30 hari) TIDAK ada di sini.
# Ia parameter BISNIS yang boleh diubah ADM tanpa restart, jadi tempatnya di
# tabel parameter_skoring dengan kode SLIK_MASA_BERLAKU_HARI (asumsi A-8).
# Menaruhnya di dua tempat akan menghasilkan dua perilaku yang berbeda.

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# URL backend yang dipakai frontend dari BROWSER, jadi memakai localhost + port
# host, bukan nama service docker. Vite menanamkan nilai ini saat BUILD, jadi di
# docker-compose.yml ia dilewatkan sebagai build arg, bukan environment runtime.
VITE_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Upload dokumen
# -----------------------------------------------------------------------------
# Direktori penyimpanan berkas upload (KTP, KK, Surat Keterangan Usaha, foto survei).
# Direktori ini masuk .gitignore — berkas upload tidak boleh ter-commit.
UPLOAD_DIR=./uploads

# Batas ukuran berkas dalam byte. 5 MB memadai untuk foto dari ponsel.
UPLOAD_MAX_BYTES=5242880

# Tipe berkas yang diterima.
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,application/pdf

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
