{
  "name": "imitra-mock-slik",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stub layanan SLIK sesuai kontrak brief 6.1. Dipanggil backend via HTTP.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "ci": "npm run lint && npm run test"
  },
  "dependencies": {
    "fastify": "4.26.2"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "4.7.2",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
